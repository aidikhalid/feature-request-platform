# Copy to .env before running: cp .env.example .env
# These are local development placeholders only. No real secrets belong in this repo.

# --- Postgres ---
POSTGRES_USER=frp
POSTGRES_PASSWORD=frp_local_password
POSTGRES_DB=frp

# --- API ---
# Consumed by the api container; host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg2://frp:frp_local_password@db:5432/frp
# Generate your own for anything non-local: openssl rand -hex 32
JWT_SECRET=dev-only-not-a-real-secret-change-me
JWT_EXPIRE_MINUTES=1440
# Cookies are only marked Secure over HTTPS; keep false for local http.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
SEED_ON_STARTUP=true

# --- Web ---
VITE_API_URL=http://localhost:8000
